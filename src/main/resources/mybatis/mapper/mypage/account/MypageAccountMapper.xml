<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.petcare.petcare.mypage.account.mapper.MypageAccountMapper">

    <!-- HYJ 26.07.29 회원 탈퇴: 비밀번호 확인용 조회 -->
    <select id="selectPasswordByMemberNo" resultType="string">
        SELECT MEMBER_PWD FROM TB_MEMBER WHERE MEMBER_NO = #{memberNo}
    </select>

    <!-- HYJ 26.07.29 회원 탈퇴: STATUS_CD = 'WITHDRAWN' -->
    <update id="updateStatusToWithdrawn">
        UPDATE TB_MEMBER SET STATUS_CD = 'WITHDRAWN' WHERE MEMBER_NO = #{memberNo}
    </update>

    <insert id="insertMemberWithdraw" parameterType="long">
        INSERT INTO TB_MEMBER_WITHDRAW (
            MEMBER_NO,
            MEMBER_ID,
            MEMBER_NAME,
            EMAIL
        )
        SELECT
            MEMBER_NO,
            MEMBER_ID,
            MEMBER_NAME,
            EMAIL
        FROM TB_MEMBER
        WHERE MEMBER_NO = #{memberNo}
    </insert>

    <!-- ══════════════════════════════════════════════
         7일 경과 탈퇴 회원 개인정보 삭제 (스케줄러용)
    ══════════════════════════════════════════════ -->

    <!-- HYJ 26.07.29 7일 경과 탈퇴 회원 MEMBER_NO 목록 조회 -->
    <select id="selectExpiredWithdrawnMemberNos" resultType="long">
        SELECT  MEMBER_NO
        FROM    TB_MEMBER_WITHDRAW
        WHERE   WITHDRAW_DATE IS NOT NULL
        AND     WITHDRAW_DATE &lt;= SYSDATE - 7
    </select>

    <!-- HYJ 26.07.29 TB_MEMBER 개인정보 익명화 (삭제 대신 NULL 처리) -->
    <update id="anonymizeMember">
        UPDATE TB_MEMBER
           SET MEMBER_ID   = MEMBER_NO,
               MEMBER_PWD  = NULL,
               MEMBER_NAME = '탈퇴회원',
               NICKNAME    = '탈퇴회원',
               EMAIL       = '탈퇴회원',
               PHONE       = NULL,
               ZIP_CODE    = NULL,
               ADDR1       = NULL,
               ADDR2       = NULL
         WHERE MEMBER_NO = #{memberNo}
    </update>

    <!-- HYJ 26.07.29 TB_MEMBER_SOCIAL 삭제 -->
    <delete id="deleteSocialByMemberNo">
        DELETE FROM TB_MEMBER_SOCIAL WHERE MEMBER_NO = #{memberNo}
    </delete>

    <!-- HYJ 26.07.29 TB_PET 삭제 -->
    <delete id="deletePetsByMemberNo">
        DELETE FROM TB_PET WHERE MEMBER_NO = #{memberNo}
    </delete>

    <!-- HYJ 26.07.29 TB_MEMBER_AGREEMENT 삭제 -->
    <delete id="deleteAgreementsByMemberNo">
        DELETE FROM TB_MEMBER_AGREEMENT WHERE MEMBER_NO = #{memberNo}
    </delete>

    <!-- HYJ 26.07.29 TB_MEMBER_WITHDRAW 삭제 -->
    <delete id="deleteMemberWithdrawByMemberNo">
        DELETE FROM TB_MEMBER_WITHDRAW WHERE MEMBER_NO = #{memberNo}
    </delete>
</mapper>
